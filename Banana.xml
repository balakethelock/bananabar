<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
    ..\..\FrameXML\UI.xsd">
    <Frame name="BananaFrame">
        <Scripts>
            <OnLoad>
                Banana_OnLoad();
            </OnLoad>
            <OnEvent>
                Banana_OnEvent(event);
            </OnEvent>
            <OnUpdate>
                Banana_OnUpdate(arg1);
            </OnUpdate>
        </Scripts>
    </Frame>
    <Frame name="BananaMtSymbolTemplate" virtual="true" movable="false">
        <Size>
            <AbsDimension x="16" y="16"/>
        </Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentSymbol" file="Interface\TargetingFrame\UI-RaidTargetingIcons" hidden="false">
					<Size>
						<AbsDimension x="16" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
            </Layer>
		</Layers>
    </Frame>
    <CheckButton name="BananaButtonTemplate" clampedToScreen="true" inherits="ActionButtonTemplate" virtual="true" movable="false">
        <Size>
            <AbsDimension x="36" y="36"/>
        </Size>
        <Scripts>
            <OnLoad>
                Banana_RaidTargetButtonOnLoad();
                this:RegisterForClicks("LeftButtonUp", "RightButtonUp", "MiddleButtonDown", "MiddleButtonUp");
            </OnLoad>
            <OnClick>
                Banana_ButtonOnClick(arg1);
            </OnClick>
            <OnMouseUp>
                Banana_ButtonOnMouseUp(arg1);
            </OnMouseUp>
            <OnMouseDown>
                Banana_ButtonOnMouseDown(arg1);
            </OnMouseDown>
            <OnEnter>
                Banana_ButtonOnEnter();
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide();
            </OnLeave>
        </Scripts>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="$parentMobName" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Size>
						<AbsDimension x="300" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="0" y="-8"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parentTargetSymbol" file="Interface\TargetingFrame\UI-RaidTargetingIcons" hidden="false">
					<Size>
						<AbsDimension x="16" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
            </Layer>
		</Layers>
    </CheckButton> 
	<CheckButton name="RaidTargetFrame1Button" parent="UIParent" id="1" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame2Button" parent="UIParent" id="2" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame3Button" parent="UIParent" id="3" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame4Button" parent="UIParent" id="4" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame5Button" parent="UIParent" id="5" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame6Button" parent="UIParent" id="6" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame7Button" parent="UIParent" id="7" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame8Button" parent="UIParent" id="8" inherits="BananaButtonTemplate" hidden="false"/>
	<CheckButton name="RaidTargetFrame9Button" parent="UIParent" id="9" inherits="BananaButtonTemplate" hidden="false"/>
</Ui>

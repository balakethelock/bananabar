<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="BananaFrame">
		<Scripts>
			<OnLoad>
				Banana_OnLoad()
			</OnLoad>
			<OnEvent>
				Banana_OnEvent(event)
			</OnEvent>
			<OnUpdate>
				Banana_OnUpdate(arg1)
			</OnUpdate>
		</Scripts>
	</Frame>
	<Frame name="BananaMtSymbolTemplate" virtual="true" movable="false">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentSymbol" file="Interface\TargetingFrame\UI-RaidTargetingIcons">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	<CheckButton name="BananaButtonTemplate" clampedToScreen="true" virtual="true" movable="false">
		<Size x="36" y="36"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentIcon" file="Interface\TargetingFrame\UI-RaidTargetingIcons">
					<Size x="35" y="35"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentCount" inherits="NumberFontNormal" justifyH="RIGHT">
					<Anchors>
						<Anchor point="BOTTOMRIGHT">
							<Offset x="-2" y="2"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<NormalTexture name="$parentNormalTexture" file="Interface\Buttons\UI-Quickslot2">
			<Size x="61" y="61"/>
			<Anchors>
				<Anchor point="CENTER"/>
			</Anchors>
		</NormalTexture>
		<PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
		<HighlightTexture alphaMode="ADD" file="Interface\Buttons\ButtonHilight-Square"/>
		<CheckedTexture alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight"/>
		<Scripts>
			<OnLoad>
				Banana_RaidTargetButtonOnLoad()
			</OnLoad>
			<OnClick>
				Banana_ButtonOnClick(arg1)
			</OnClick>
			<OnMouseUp>
				Banana_ButtonOnMouseUp(arg1)
			</OnMouseUp>
			<OnMouseDown>
				Banana_ButtonOnMouseDown(arg1)
			</OnMouseDown>
			<OnEnter>
				Banana_ButtonOnEnter()
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide()
			</OnLeave>
		</Scripts>
	</CheckButton> 
	<CheckButton name="RaidTargetFrame1Button" parent="UIParent" id="1" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame2Button" parent="UIParent" id="2" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame3Button" parent="UIParent" id="3" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame4Button" parent="UIParent" id="4" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame5Button" parent="UIParent" id="5" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame6Button" parent="UIParent" id="6" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame7Button" parent="UIParent" id="7" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame8Button" parent="UIParent" id="8" inherits="BananaButtonTemplate"/>
	<CheckButton name="RaidTargetFrame9Button" parent="UIParent" id="9" inherits="BananaButtonTemplate"/>
</Ui>

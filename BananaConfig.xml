<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="BananaConfigFrame" parent="UIParent" movable="true" toplevel="true" hidden="true">
		<Size x="310" y="480"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<BackgroundInsets left="5" right="5" top="5" bottom="5"/>
			<TileSize val="16"/>
			<EdgeSize val="16"/>
			<Color r="0" g="0" b="0" a="1"/>
		</Backdrop>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="BananaConfigFrameTitle" inherits="GameFontNormalLarge" text="BananaBar Raid Symbols" justifyH="CENTER">
					<Anchors>
						<Anchor point="TOP">
							<Offset x="0" y="-14"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="BananaConfigFrameFrameClose" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT">
						<Offset x="-5" y="-5"/>
					</Anchor>
				</Anchors>
			</Button>
			<Slider name="BananaConfigFrameResizeSlider" minValue="10" maxValue="200" defaultValue="100" valueStep="1" inherits="OptionsSliderTemplate">
				<Size x="238" y="17"/>
				<Anchors>
					<Anchor point="TOP">
						<Offset x="0" y="-70"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						BananaConfigFrameResizeSliderLow:SetText("10%")
						BananaConfigFrameResizeSliderText:SetText("Buttons scale")
						BananaConfigFrameResizeSliderHigh:SetText("200%")
					</OnLoad>
					<OnValueChanged>
						BananaConfig_ValueChangedResize()
					</OnValueChanged>
				</Scripts>
			</Slider>
			<Frame name="$parentComboBoxLayout" inherits="UIDropDownMenuTemplate">
				<Size x="261" y="32"/>
				<Anchors>
					<Anchor point="TOP" relativeTo="BananaConfigFrameResizeSlider" relativePoint="BOTTOM">
						<Offset x="0" y="-35"/>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="$parentTitle" inherits="GameFontNormalSmall" text="Layout" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP">
									<Offset x="0" y="13"/>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<Button name="$parentDefaults" inherits="UIPanelButtonTemplate2" text="Defaults">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset x="0" y="20"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						Banana_Default()
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				tinsert(UISpecialFrames, "BananaConfigFrame")
			</OnLoad>
			<OnMouseDown>
				BananaConfigFrame:StartMoving()
			</OnMouseDown>
			<OnMouseUp>
				BananaConfigFrame:StopMovingOrSizing()
			</OnMouseUp>
		</Scripts>
	</Frame>
</Ui>
